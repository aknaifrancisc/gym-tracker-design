        "selector": "JSXOpeningElement[name.name='TrendBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|highlight|key|ref|className|style|children)$/]",
        "message": "<TrendBar> doesn't accept that prop. Declared props: label, value, highlight."
